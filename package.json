{
  "name": "with-vite-react",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs}": [
      "oxfmt",
      "oxlint"
    ]
  },
  "packageManager": "pnpm@8.15.6"
}
